<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.misha.millionaire.ui.StartController">
    <children>
        <VBox alignment="CENTER" spacing="16.0" maxWidth="520" styleClass="start-panel">
            <children>
                <Label text="Who Wants to Be a Millionaire?" styleClass="title-label" />
                <Label text="Enter player name" styleClass="subtitle-label" />
                <TextField fx:id="nameField" promptText="Name" maxWidth="280" />
                <Label fx:id="errorLabel" styleClass="error-label" />
                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Button text="Leaderboard" onAction="#onLeaderboard" styleClass="secondary-button" />
                        <Button text="Start" onAction="#onStart" styleClass="primary-button" />
                        <Button text="Open database folder" onAction="#onOpenData" styleClass="secondary-button" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
</StackPane>
