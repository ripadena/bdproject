<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.misha.millionaire.ui.LeaderboardController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="14.0" maxWidth="620" styleClass="start-panel">
            <children>
                <Label text="Leaderboard" styleClass="title-label" />
                <Label text="TOP-10 completed games" styleClass="subtitle-label" />
                <VBox fx:id="scoresBox" spacing="8" maxWidth="560" />
                <Label fx:id="messageLabel" wrapText="true" maxWidth="560" styleClass="error-label" />
                <Button text="Back" onAction="#onBack" styleClass="secondary-button" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
</StackPane>
