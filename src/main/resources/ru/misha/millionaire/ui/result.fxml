<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.misha.millionaire.ui.ResultController">
    <children>
        <Label text="Result" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label fx:id="resultLabel" wrapText="true" maxWidth="720" />
        <Label text="TOP-10" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <VBox fx:id="scoresBox" spacing="4" />
        <Button text="Play again" onAction="#onPlayAgain" />
    </children>
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
</VBox>